{
  "name": "postflow",
  "private": true,
  "version": "0.1.27",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "server": "cargo run -p postflow-web -- --local-dir .postflow-dev/local",
    "server:demo": "cargo run -p postflow-web -- --local-dir .postflow-dev/local --memory-secrets",
    "release": "node scripts/release.mjs",
    "demo": "cargo run -q -p postflow-testkit --bin demo-server",
    "screenshots": "node scripts/screenshots.mjs",
    "test:ui": "node --test src/lib/*.test.ts",
    "build:plugins": "rolldown examples/plugins/textrank-zh/src/main.js --format esm --file examples/plugins/textrank-zh/main.js --banner \"// Built from src/main.js by npm run build:plugins. Includes textrank4zh-ts 0.4.0 (MIT, Copyright (c) ChasLui); see vendor/README.md.\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "16.36.0",
    "uqr": "0.1.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
