{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口权限：窗口拖拽、目录选择、用系统浏览器打开链接、在线更新",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-url",
    "updater:default",
    "process:allow-restart"
  ]
}
