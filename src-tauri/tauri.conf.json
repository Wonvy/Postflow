{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Postflow",
  "version": "../package.json",
  "identifier": "app.postflow.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Postflow",
        "width": 1280,
        "height": 800,
        "minWidth": 920,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob:; media-src 'self' https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' https: http:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Wonvy",
    "copyright": "© 2026 Wonvy",
    "homepage": "https://github.com/Wonvy/Postflow",
    "category": "Productivity",
    "shortDescription": "Mail and RSS in one inbox",
    "longDescription": "Postflow brings your email and RSS feeds into one inbox. Your data stays on your own devices; no server or account needed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NDFERjIwNzQzNEU4MzcKUldRMzZEUjBJTjlCeE9iMlBsQkNMVHRKOTQ5WlpuTytJY2Rib1hMQVRsYW5BcHJ4YkVaTzhRRzgK",
      "endpoints": [
        "https://github.com/Wonvy/Postflow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
